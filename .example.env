# -----------------------------------------------------------
# Project Management Application - Environment Variables
# -----------------------------------------------------------
# Copy this file to `.env` and replace the placeholder values
# with your own. Never commit real secrets to version control.
# -----------------------------------------------------------

# ===========================================================
# 1. Server
# ===========================================================
# Port the Express app listens on (default: 3000 if omitted)
PORT=3000

# Public URL of this server, used to build absolute links for
# uploaded task attachments (e.g. http://localhost:3000)
SERVER_URL=http://localhost:3000

# Comma-separated list of origins allowed by CORS
# (default: http://localhost:5173 if omitted)
CORS_ORIGIN=http://localhost:5173

# ===========================================================
# 2. Database
# ===========================================================
# MongoDB connection string (Atlas or local)
# Example Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# ===========================================================
# 3. Authentication (JWT)
# ===========================================================
# Long, random secrets used to sign access & refresh tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Token lifetimes (msgs: https://github.com/vercel/ms)
ACCESS_TOKEN_EXPIRY=5m
REFRESH_TOKEN_EXPIRY=1d

# ===========================================================
# 4. Password Reset
# ===========================================================
# Frontend URL the reset email links to. The reset token is
# appended to this path by the backend.
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:3000/reset-password

# ===========================================================
# 5. Email (Nodemailer + Mailgen via Mailtrap)
# ===========================================================
# Mailtrap sandbox credentials (get them from your Mailtrap inbox)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_mailtrap_user
MAILTRAP_SMTP_PASS=your_mailtrap_pass

# Default sender address for outgoing emails
FROM_EMAIL=mail.taskmanager@example.com
